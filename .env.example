# Copy to .env and fill in what you have. .env is gitignored — never commit it.
# slurm/_env.sh sources this file at the start of every job.

# Hugging Face — needed for licence-gated repos (Llama, Gemma).
# Without it those models are skipped rather than failing with 403s.
HF_TOKEN=

# Commercial APIs — run_api.sh uses whichever of these are set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
